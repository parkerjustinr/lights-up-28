  "faq": {
    "heading": "FAQ",
    "items": [
      {
        "q": "Where do I pick up my badge?",
        "a": "At the front desk in the Nave Carolina foyer from {{2028-04-11 08:00}} both days, with a photo ID."
      },
      {
        "q": "Will the keynotes be recorded?",
        "a": "Yes, every keynote and breakout is sent to your work email the week after."
      },
      {
        "q": "Can you handle my dietary needs?",
        "a": "Yes, add them when you register and the kitchen will plan for them."
