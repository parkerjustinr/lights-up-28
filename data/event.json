  "faq": {
    "heading": "FAQ",
    "items": [
      {
        "q": "Where do I pick up my badge?",
        "a": "At the front desk in the Nave Carolina foyer from 8:00 AM both days. Bring a photo ID."
      },
      {
        "q": "Will the keynotes be recorded?",
        "a": "Yes. All six keynotes and every breakout are recorded and sent to your work email the week after. Labs are not recorded."
      },
      {
        "q": "Can you handle my dietary needs?",
        "a": "Yes. Add them when you register and the kitchen will plan for them. Vegetarian and vegan options are at every meal."
      },
      {
        "q": "Can a colleague go in my place?",
        "a": "Yes. Reply to your confirmation email with their name and work email before Apr 4 and we will move the registration."
      },
      {
        "q": "Is the hall step-free?",
        "a": "Yes. Nave Carolina is on one level with a step-free entrance, and the Main Stage has wheelchair spaces in the front row."
      },
      {
        "q": "How do I deal with the altitude?",
        "a": "Quito sits at about 2,850 m. Plan an easy first day, drink water, and go light on alcohol at opening night."
      },
      {
        "q": "Is there wifi?",
        "a": "Yes, across the whole hall. The network name and password are printed on your badge."
      },
      {
        "q": "How do I cancel?",
        "a": "Reply to your confirmation email any time before the event. If you had a lab seat, it goes to the next person in line."
      }
    ]
  }
}