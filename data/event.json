  "venue": {
    "heading": "Getting there",
    "intro": "Nave Carolina is in Iñaquito, Quito, a short walk from La Carolina Metro station.",
    "equator": {
      "lineLabel": "0° Equator",
      "dotLabel": "Nave Carolina · 0° 11′ S · 2,850 m up",
      "text": "About 21 km south of the equator."
    },
    "feature": {
      "title": "Tarnell shuttle",
      "tag": "Recommended",
      "body": "Free from UIO arrivals to Nave Carolina, {{2028-04-10 10:00|day}} to {{2028-04-10 22:00}}, every 30 minutes."
    },
    "mapLink": "",
    "items": [
      {
        "title": "Metro",
        "body": "Take Quito Metro Line 1 (Quitumbe to El Labrador, 15 stations) to La Carolina station, at Avenida Eloy Alfaro and Avenida de La República at the south end of Parque La Carolina, a short walk from Nave Carolina."
      },
      {
        "title": "Paying for the Metro",
        "body": "Pay at the turnstile with cash or the Tarjeta Ciudad, Quito's transit card."
      },
      {
        "title": "From the airport",
        "body": "The Metro doesn't reach Mariscal Sucre International (UIO) in Tababela, but public buses run from the airport to the Río Coca and Carcelén terminals in the north and Quitumbe in the south, and taxis wait outside arrivals."
      }
    ]
  },
  "phrases": {
    "heading": "Say it in Quito",
    "items": [
      {
        "es": "Buenos días.",
        "en": "Good morning.",
        "say": "BWEH-nohs DEE-ahs"
      },
      {
        "es": "¿Dónde está el Metro?",
        "en": "Where's the Metro?",
        "say": "DOHN-deh ehs-TAH ehl MEH-troh"
      },
      {
        "es": "A la estación La Carolina, por favor.",
        "en": "To La Carolina station, please.",
        "say": "ah lah ehs-tah-SYOHN lah kah-roh-LEE-nah, pohr fah-VOHR"
      },
      {
        "es": "Vengo a la conferencia.",
        "en": "I'm here for the conference.",
        "say": "BEHN-goh ah lah kohn-feh-REHN-syah"
      },
      {
        "es": "¿Dónde está el baño?",
        "en": "Where's the bathroom?",
        "say": "DOHN-deh ehs-TAH ehl BAH-nyoh"
      },
      {
        "es": "Un café, por favor.",
        "en": "A coffee, please.",
        "say": "oon kah-FEH, pohr fah-VOHR"
      },
      {
        "es": "¿Cuánto cuesta?",
        "en": "How much is it?",
        "say": "KWAHN-toh KWEHS-tah"
      },
      {
        "es": "La cuenta, por favor.",
        "en": "The check, please.",
        "say": "lah KWEHN-tah, pohr fah-VOHR"
      },
      {
        "es": "¿Me espera un momentito, por favor?",
        "en": "Could you wait a moment for me, please? In Ecuador, \"-ito\" softens a request.",
        "say": "meh ehs-PEH-rah oon moh-mehn-TEE-toh, pohr fah-VOHR"
      },
      {
        "es": "¡Qué bestia!",
        "en": "How crazy! An Ecuadorian way to say \"no way.\"",
        "say": "keh BEHS-tyah"
      }
    ],
